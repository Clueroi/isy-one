// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id       String     @id @default(uuid())
  name     String
  email    String     @unique
  password String

  @@map("users")
}

model Script {
  id          String   @id @default(uuid())
  name        String
  description String

  path        String

  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  Execution[]

  @@map("scripts")
}

model Execution {
  id          String   @id @default(uuid())

  scriptId    String
  script      Script   @relation(fields: [scriptId], references: [id])

  status      ExecutionStatus

  parameters  Json?

  stdout      String?
  stderr      String?

  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  createdAt   DateTime @default(now())

  @@map("executions")
}

model Setting {
  id        String   @id @default(uuid())

  key       String   @unique

  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Organization {
  id    String @id @default(uuid())
  name  String
  email String @unique

  description String?
  website     String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  slug String @unique


  @@map("organizations")
}

